# Copy this to .env for local development (do not commit a real .env file).

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Postgres connection string for this service's own database.
DATABASE_URL=postgres://chiguru:password@localhost:5432/chiguru

# Firebase (Console → Project settings → Service accounts → Generate new
# private key).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay (dashboard.razorpay.com → Settings → API Keys / Webhooks)
# Use test-mode keys (rzp_test_...) for local/dev; switch to live keys (rzp_live_...) for production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Base URL of the deployed web app (used in redirect/notification copy).
PUBLIC_APP_URL=http://localhost:5173

# OpenAI (from platform.openai.com/api-keys)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional — only needed if src/lib/gmail.ts's Replit-connector Gmail
# integration is actually used.
REPLIT_CONNECTORS_HOSTNAME=
REPL_IDENTITY=
WEB_REPL_RENEWAL=
